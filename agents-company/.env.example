# Copy this file to .env (same folder) and fill it in step by step.
# The company reads .env automatically; variables set in your shell override it.
# Never commit .env: it holds your keys (it is already in .gitignore).
# Full guide: GETTING_STARTED.md

# ─── Step 1: AI (scripts, voice, images) ────────────────────────────────────
# Option A: FreeLLMAPI (free tiers, for testing). Install the desktop app
# (Windows/macOS) or the Docker one-liner (Linux), add provider keys on its Keys
# page, enable at least one speech model and one image model on its Models page,
# then paste the unified key (Keys page header / tray popover) here.
FREELLMAPI_API_KEY=
# Desktop app: port 31415. Docker: 3001 (the default, so leave this commented).
# FREELLMAPI_BASE_URL=http://localhost:31415/v1

# Option B: a paid OpenAI-compatible API (required in production mode).
# Pick model names from your provider's model list.
# AGENTS_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# AGENTS_MODEL=
# AGENTS_STRONG_MODEL=
# AGENTS_MEDIA_BASE_URL=https://api.openai.com/v1
# AGENTS_MEDIA_API_KEY=
# AGENTS_TTS_MODEL=
# AGENTS_IMAGE_MODEL=

# Voice for the narration (names depend on the speech model).
# AGENTS_TTS_VOICE=alloy

# Optional but recommended: live web research with sources.
# Through FreeLLMAPI this needs a search key (Tavily, Exa, Brave…) on its Keys page.
# Or use Tavily directly:
# TAVILY_API_KEY=

# ─── Step 2: your channel ───────────────────────────────────────────────────
AGENTS_CHANNEL_NICHE="personal finance for students"
AGENTS_CHANNEL_NAME=
# Where viewers go to become subscribers or customers (newsletter / product page).
AGENTS_CHANNEL_LINK=
# AGENTS_CHANNEL_CTA="Free newsletter"

# ─── Step 3: YouTube upload + analytics ─────────────────────────────────────
# Google Cloud Console → enable "YouTube Data API v3" and "YouTube Analytics API"
# → OAuth consent screen (External, add yourself as test user)
# → Credentials → OAuth client ID → "Desktop app". Then run: npm run youtube-auth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Start unlisted so you can check the first uploads; switch to public later.
AGENTS_YOUTUBE_PRIVACY=unlisted
# AGENTS_YOUTUBE_SYNTHETIC=1      # AI disclosure (keep on)
# AGENTS_YOUTUBE_ANALYTICS=1      # pull stats automatically

# ─── Step 4: the daemon's schedule ──────────────────────────────────────────
# YouTube only to start with; add ",company" once the income side is set up.
AGENTS_DAEMON_JOBS=studio
AGENTS_STUDIO_EVERY=24h
AGENTS_STUDIO_VIDEOS=1
# AGENTS_STUDIO_MAX_PENDING=4     # pause making Shorts while this many wait for review
# AGENTS_DAEMON_CHECK=10m

# ─── Later: the income side (landing pages, signups, newsletter) ────────────
# See README → "Publish landing pages", "Signups and the feedback loop", "Emailing subscribers".
# AGENTS_FOCUS="online income sources a solo founder can start with little capital"
# AGENTS_GITHUB_PAGES_REPO=yourname/launches
# AGENTS_GITHUB_TOKEN=
# AGENTS_WEBHOOK_SECRET=
# AGENTS_SIGNUP_URL=https://signup.yourdomain.com
# AGENTS_BUSINESS_NAME=
# AGENTS_CONTACT_EMAIL=
# RESEND_API_KEY=
# AGENTS_EMAIL_FROM="Your Business <hello@yourdomain.com>"
# AGENTS_POSTAL_ADDRESS=

# ─── Production (when you rely on it for real income) ───────────────────────
# Refuses free tiers and missing safety settings; see README → Testing vs production.
# AGENTS_ENV=production
